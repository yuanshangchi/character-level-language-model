# -----------------------------------------------------------------------------
# This .envrc ensures that the correct Mamba environment is automatically
# activated when entering this repo or opening a terminal in VSCode.
#
# How it works:
# - We installed `direnv` via:    brew install direnv
# - We enabled direnv in zsh by adding to ~/.zshrc:    eval "$(direnv hook zsh)"
# - We ran:    direnv allow    (to trust this .envrc in this repo. Do it whenever you .envrc changes)
#
# Why needed:
# - VSCode does not properly auto-activate Mamba envs in terminal, even when
#   selecting the Python interpreter via Cmd+Shift+P.
# - direnv + .envrc is the most reliable way to ensure the terminal uses the
#   correct Mamba env automatically.
#
# Notes:
# - You only need to run `direnv allow` once per repo after editing this file.
# - If you change the env name, update MAMBA_ENV_NAME below or use the .mamba-env-name trick.
# -----------------------------------------------------------------------------

# Load mamba shell hook (required for mamba activate to work in shell)
eval "$(mamba shell hook --shell zsh)"

# Define the Mamba env to activate
MAMBA_ENV_NAME="py3_11_nlp_project"
# Alternatively, you can use a .mamba-env-name file in the root of the repo
# that contains just the env name, e.g.:
#   echo "py3_11_nlp_project" > .mamba-env-name
# And then uncomment the next line to read from that file:
# MAMBA_ENV_NAME=$(cat .mamba-env-name)

mamba activate $MAMBA_ENV_NAME
